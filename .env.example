# Supabase.com saytiga kiring -> Loyihangiz -> Project Settings -> API:
# 1. Project URL ni quyidagi VITE_SUPABASE_URL ga qo'ying
# 2. anon / public API key ni quyidagi VITE_SUPABASE_ANON_KEY ga qo'ying

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
